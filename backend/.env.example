DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# PRIVATE server-side Mapbox token (never ship to the browser)
MAPBOX_SERVER_TOKEN=
PROVIDER_TIMEOUT_S=10
# Number of trusted reverse proxies in front of the app (0 = no proxy; 1 = default for Render/Railway/etc.)
NUM_PROXIES=1
# Abuse guard: burst detection for expensive endpoints (/api/analyze, /api/heatmap)
# Note: limits are per-process (LocMemCache); see AbuseGuardMiddleware docs for details.
ABUSE_BURST_LIMIT=30
ABUSE_WINDOW_S=60
ABUSE_BLOCK_S=300
# IP(s) trusted to set X-Forwarded-For (gunicorn forwarded_allow_ips)
FORWARDED_ALLOW_IPS=127.0.0.1
